# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Environment variables & secrets
.env
.env.local

# Virtual environments
.venv/
venv/
ENV/
env/

# Unit test / coverage
.pytest_cache/
.coverage
htmlcov/

# Dynamic Target Profiles (Keep only .gitkeep)
profiles/*
!profiles/.gitkeep

# Media, video and audio downloads
*.mp3
*.webm
*.mp4
*.wav
*.avi
*.mkv

# OS artifacts
.DS_Store
Thumbs.db
