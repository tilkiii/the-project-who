# ==============================================================================
# "who??" Framework Configuration (.env)
# Enterprise Multimodal OSINT, Neo4j Graph Intelligence & Evidence-Based Digital Twin
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI MODEL & PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Set the API key for whichever AI provider you want to use.
# who?? auto-detects your active provider in this priority order:
#   Gemini -> OpenAI -> Claude -> Groq -> DeepSeek -> OpenRouter -> Ollama (Local)
#
# You can also explicitly force a specific provider:
#   WHO_PROVIDER=gemini       # Options: gemini, openai, anthropic, groq, deepseek, openrouter, ollama
#
# You can override the default model:
#   DEFAULT_LLM_MODEL=gemini-2.5-flash

# --- Google Gemini (Recommended - Free Tier Available) ---
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- OpenAI (GPT-4o, GPT-4o-mini) ---
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_BASE=https://api.openai.com/v1

# --- Anthropic (Claude 3.5 Sonnet / Haiku) ---
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- Groq (Ultra-Fast Open Source Models - Free Tier Available) ---
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- DeepSeek (DeepSeek V3 / R1) ---
# Get key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# --- OpenRouter (Universal AI Proxy) ---
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Mistral AI ---
# Get key: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# --- Local Ollama (Completely Local & Free - No Key Required) ---
# Download: https://ollama.ai
# Run: ollama run llama3.2
OLLAMA_API_BASE=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# --- Local vLLM (High-Throughput Local Engine) ---
VLLM_API_BASE=http://localhost:8000/v1


# ------------------------------------------------------------------------------
# 2. NEO4J GRAPH DATABASE & GDS CONNECTION (Optional - Local Fallback Active)
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j


# ------------------------------------------------------------------------------
# 3. DIRECTORY & STORAGE PATHS
# ------------------------------------------------------------------------------
PROFILES_DIR=profiles


# ------------------------------------------------------------------------------
# 4. SCIENTIFIC RIGOR & EPISTEMIC SETTINGS
# ------------------------------------------------------------------------------
# Strict probabilistic mode: rejects absolute or deterministic claims about human motives
STRICT_EPISTEMIC_MODE=true
MIN_CONFIDENCE_THRESHOLD=0.65
EVIDENCE_MIN_QUOTES=2


# ------------------------------------------------------------------------------
# 5. LOGGING & VERBOSITY
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
DEBUG=false
