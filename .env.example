# ==============================================================================
# "who??" Framework Configuration (.env)
# Enterprise Multimodal OSINT, Neo4j Graph Intelligence & Evidence-Based Digital Twin
# ==============================================================================

# LLM & Embedding Model Settings (via LiteLLM)
# Supported prefixes: openai/, gemini/, anthropic/, groq/, ollama/, vllm/
DEFAULT_LLM_MODEL=gemini/gemini-2.5-flash
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Provider API Keys (Set whichever you use)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Local LLM Server Bases (Optional for Ollama / vLLM)
OLLAMA_API_BASE=http://localhost:11434
VLLM_API_BASE=http://localhost:8000/v1

# Neo4j Graph Database & GDS Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Storage & Directory Paths
PROFILES_DIR=profiles

# Scientific Rigor & Epistemic Settings
MIN_CONFIDENCE_THRESHOLD=0.65
EVIDENCE_MIN_QUOTES=2
STRICT_EPISTEMIC_MODE=true

# Logging & Verbosity
LOG_LEVEL=INFO
DEBUG=false
